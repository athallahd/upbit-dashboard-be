# Copy this file to .env and set this to a newly rotated webhook.
SLACK_INCOMING_WEBHOOK_URL=<set-in-local-environment>

# Optional; the default is Slack's standard Web API endpoint.
SLACK_POST_MESSAGE_URL=https://slack.com/api/chat.postMessage

# Executive Dashboard
DASHBOARD_DB_ALIAS=reporter
DASHBOARD_APPROVED_SECURITY_LEVEL=2
DASHBOARD_DORMANT_DAYS=180
DASHBOARD_REVENUE_FIELD=fiat_fee
